# =============================================================================
# SCIP 10.0 Settings for Infeasibility Proofs
# Variant: CLIQUE-CENTRIC
# =============================================================================
# Maximize probing and implication graph for binary "at most K of N" constraints.
# Your triangle/notruetwins constraints are ideal for clique detection.
#
# Launch:
#   scip.exe -c "set heuristics emphasis off set presolving emphasis aggressive set separating emphasis fast set load SCIP_Runs\infeasibility_clique_centric.set read <instance>.lp optimize quit"
# =============================================================================

# ---------------------------------------------------------------------------
# PRESOLVING — individual settings with probing emphasis
# ---------------------------------------------------------------------------
presolving/maxrounds = -1
presolving/maxrestarts = -1

# Maximize probing: tentatively fix each binary var and propagate
# to discover implications. Expensive at startup but fills implication graph.
propagating/probing/maxprerounds = -1

# Enable logicor implication detection
constraints/logicor/implications = TRUE

# ---------------------------------------------------------------------------
# SEPARATING — selective (complement emphasis fast)
# ---------------------------------------------------------------------------
separating/maxrounds = 5
separating/maxroundsroot = 20
separating/maxstallroundsroot = 10

# ---------------------------------------------------------------------------
# CONFLICT ANALYSIS — FULL
# ---------------------------------------------------------------------------
conflict/enable = TRUE
conflict/useinflp = b
conflict/useprop = TRUE
conflict/usepseudo = TRUE
conflict/usesb = TRUE
conflict/maxconss = -1
conflict/maxstoresize = 15000

# ---------------------------------------------------------------------------
# NODE SELECTION — Restart DFS
# ---------------------------------------------------------------------------
nodeselection/restartdfs/stdpriority = 100000

# ---------------------------------------------------------------------------
# BRANCHING — Binary with pseudo-cost
# ---------------------------------------------------------------------------
branching/preferbinary = TRUE
branching/relpscost/sbiterquot = 0.5
branching/relpscost/maxreliable = 8.0

# ---------------------------------------------------------------------------
# PROPAGATION — MAXIMUM
# ---------------------------------------------------------------------------
propagating/maxrounds = -1
propagating/maxroundsroot = -1
propagating/abortoncutoff = FALSE

# ---------------------------------------------------------------------------
# SYMMETRY — Enable
# ---------------------------------------------------------------------------
misc/usesymmetry = 7

# ---------------------------------------------------------------------------
# DISPLAY
# ---------------------------------------------------------------------------
display/freq = 100
