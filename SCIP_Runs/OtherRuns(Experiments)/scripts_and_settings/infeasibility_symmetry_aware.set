# =============================================================================
# SCIP 10.0 Settings for Infeasibility Proofs
# Variant: SYMMETRY-AWARE
# =============================================================================
# Exploits vertex permutation symmetry in A and B sets.
# SCIP 10.0.1 with Nauty 2.8.8 + sassy 2.0 (SYM=snauty)
#
# IMPORTANT: emphasis settings must be set via the command line BEFORE loading
# this file. Use the launch command below.
#
# Launch:
#   scip.exe -c "set heuristics emphasis off set presolving emphasis aggressive set separating emphasis default set load SCIP_Runs\infeasibility_symmetry_aware.set read <instance>.lp optimize quit"
# =============================================================================

# ---------------------------------------------------------------------------
# PRESOLVING — individual settings (complement the emphasis)
# ---------------------------------------------------------------------------
presolving/maxrounds = -1
presolving/maxrestarts = -1

# ---------------------------------------------------------------------------
# SYMMETRY — MAXIMIZED (the key differentiator of this preset)
# ---------------------------------------------------------------------------
# Enable all symmetry handling methods:
#   bit 1 (1) = constraint-based (orbitopes, symresacks, lex reduction)
#   bit 2 (2) = orbital reduction (orbital fixing)
#   bit 3 (4) = SST cuts (Schreier-Sims table)
misc/usesymmetry = 7

# Detect symmetries DURING presolving (not at the end)
propagating/symmetry/symtiming = 1

# Use signed permutation symmetries (SCIP 10.0 feature)
propagating/symmetry/symtype = 1

# SST leader variable type: 6 = binary+integer+implicit integer (SCIP 10 default)
propagating/symmetry/sstleadervartype = 6

# ---------------------------------------------------------------------------
# SEPARATING — control LP size (individual params)
# ---------------------------------------------------------------------------
separating/maxrounds = 10
separating/maxroundsroot = 30

# ---------------------------------------------------------------------------
# CONFLICT ANALYSIS — FULL
# ---------------------------------------------------------------------------
conflict/enable = TRUE
conflict/useinflp = b
conflict/useprop = TRUE
conflict/usepseudo = TRUE
conflict/usesb = TRUE
conflict/maxconss = -1
conflict/maxstoresize = 10000

# ---------------------------------------------------------------------------
# NODE SELECTION — Restart DFS
# ---------------------------------------------------------------------------
nodeselection/restartdfs/stdpriority = 100000

# ---------------------------------------------------------------------------
# BRANCHING — Binary preference
# ---------------------------------------------------------------------------
branching/preferbinary = TRUE

# ---------------------------------------------------------------------------
# PROPAGATION — FULL
# ---------------------------------------------------------------------------
propagating/maxrounds = -1
propagating/maxroundsroot = -1
propagating/abortoncutoff = FALSE
propagating/probing/maxprerounds = -1

# ---------------------------------------------------------------------------
# DISPLAY
# ---------------------------------------------------------------------------
display/freq = 100
